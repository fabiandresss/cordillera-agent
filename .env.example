# Proveedor de LLM: groq | ollama | rules (rules = sin LLM, 100% determinista y offline)
LLM_PROVIDER=ollama
GROQ_API_KEY=pega_tu_clave_aqui
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Embeddings: ollama | fake (fake = hashing de palabras, solo para pruebas offline)
EMBEDDINGS_PROVIDER=ollama
